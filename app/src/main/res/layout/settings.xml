<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/auto_profile_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/disable_auto_profile" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/use_shizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/use_shizuku" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/block_keyboard_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/block_keyboard_input" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/editor_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/open_editor_as_overlay" />


        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/touch_jitter_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/touch_jitter" />

        <TextView
            android:id="@+id/touch_jitter_spread_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/touch_jitter_spread" />

        <com.google.android.material.slider.Slider
            android:id="@+id/touch_jitter_spread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="50"
            android:stepSize="1"
            android:value="15" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/show_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:labelFor="@id/show_controls_opacity"
            android:text="@string/show_controls_on_screen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opacity" />

        <com.google.android.material.slider.Slider
            android:id="@+id/show_controls_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="1" />
    </LinearLayout>
</ScrollView>